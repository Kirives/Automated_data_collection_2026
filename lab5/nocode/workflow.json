    {
      "id": "bd530e7b-0d9d-4446-b854-6dace67190ca",
      "name": "Обход карточек",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "c77640dd-8442-4cdf-acff-6cacc60d4207",
      "name": "Загрузить карточку",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        260
      ],
      "parameters": {
        "url": "={{ $json.product_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "UniversityLab5/1.0 (educational crawl on toscrape.com)"
            },
            {
              "name": "Accept-Encoding",
              "value": "identity"
            }
          ]
        },
        "options": {
          "timeout": 25000,
          "response": {
            "response": {
              "responseFormat": "text",
              "fullResponse": true
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "7507716f-1e88-424e-8a50-009877cabb43",
      "name": "Поля карточки",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        880,
        260
      ],
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": ".product_main h1",
              "returnValue": "text"
            },
            {
              "key": "headers",
              "cssSelector": "table.table tr th",
              "returnValue": "text",
              "returnArray": true
            },
            {
              "key": "values",
              "cssSelector": "table.table tr td",
              "returnValue": "text",
              "returnArray": true
            },
            {
              "key": "category",
              "cssSelector": ".breadcrumb a[href*='category/books/']",
              "returnValue": "text"
            },
            {
              "key": "description",
              "cssSelector": "#product_description + p",
              "returnValue": "text"
            },
            {
              "key": "rating",
              "cssSelector": ".product_main .star-rating",
              "returnValue": "attribute",
              "attribute": "class"
            }
          ]
        },
        "options": {
          "trimValues": true,
          "cleanUpText": false
        }
      }
    },
    {
      "id": "1731b8f0-0b7e-4830-b6b5-6785c09ac8ec",
      "name": "Обязательные поля",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        260
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "21b1706c-2f81-4567-873e-a03ef0afa033",
              "leftValue": "={{ Boolean($json.title && $json.category && $json.description && $json.values[$json.headers.indexOf('UPC')] && /^£[0-9]+[.][0-9]+$/.test($json.values[$json.headers.indexOf('Price (excl. tax)')]) && /[0-9]+ available/.test($json.values[$json.headers.indexOf('Availability')]) && /^[0-9]+$/.test($json.values[$json.headers.indexOf('Number of reviews')])) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ab0c6cf8-e813-4bc1-8914-b5e470f46025",
      "name": "Привести типы",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        260
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cda6397d-0d40-42f2-9307-56703fc82f27",
              "name": "upc",
              "value": "={{ $json.values[$json.headers.indexOf('UPC')].trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "8eef670d-645a-49f6-9f23-95ba1bd52c28",
              "name": "title",
              "value": "={{ $json.title.replace(/\\s+/g,' ').trim() }}",
              "type": "string"
            },
            {
              "id": "fe07c971-d76f-4343-b067-213b49b0c7e0",
              "name": "price_excl_tax",
              "value": "={{ $json.values[$json.headers.indexOf('Price (excl. tax)')].replace('£','') }}",
              "type": "string"
            },
            {
              "id": "2a4a3cc0-3f20-4712-8020-998176d55a5c",
              "name": "stock_count",
              "value": "={{ Number($json.values[$json.headers.indexOf('Availability')].match(/([0-9]+) available/)[1]) }}",
              "type": "number"
            },
            {
              "id": "34296b1d-897c-4009-9509-d2c94a68ae9f",
              "name": "review_count",
              "value": "={{ Number($json.values[$json.headers.indexOf('Number of reviews')]) }}",
              "type": "number"
            },
            {
              "id": "10917ed4-16ff-4cf3-b68b-bf36869208df",
              "name": "category",
              "value": "={{ $json.category.trim() }}",
              "type": "string"
            },
            {
              "id": "503774cd-e3c4-4da9-acb0-5fe7a47bde9d",
              "name": "description",
              "value": "={{ $json.description.replace(/\\s+/g,' ').trim() }}",
              "type": "string"
            },
            {
              "id": "d8148735-3372-4101-ae5a-4df4b13cf8a9",
              "name": "rating",
              "value": "={{ ['One','Two','Three','Four','Five'].indexOf($json.rating.replace('star-rating','').trim()) + 1 }}",
              "type": "number"
            },
            {
              "id": "2ba5a7ad-f52c-49b6-9c11-0efae736735f",
              "name": "source_url",
              "value": "={{ $('Обход карточек').item.json.product_url }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
