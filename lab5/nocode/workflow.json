    {
      "id": "8e7eb62e-5814-40fe-92aa-30fb94cd46d2",
      "name": "Две страницы каталога",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "https://books.toscrape.com/catalogue/page-1.html",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "UniversityLab5/1.0 (educational crawl on toscrape.com)"
            },
            {
              "name": "Accept-Encoding",
              "value": "identity"
            }
          ]
        },
        "options": {
          "timeout": 25000,
          "response": {
            "response": {
              "responseFormat": "text",
              "fullResponse": true
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ 'https://books.toscrape.com/catalogue/' + $response.body.match(/class=\"next\"[\\s\\S]*?href=\"([^\"]+)\"/)[1] }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.includes('class=\"next\"') }}",
              "limitPagesFetched": true,
              "maxRequests": 2,
              "requestInterval": 1000
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "d03d3550-8d5e-456d-a3df-ba7c5e4e1138",
      "name": "Ссылки из HTML",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "links",
              "cssSelector": "article.product_pod h3 a",
              "returnValue": "attribute",
              "attribute": "href",
              "returnArray": true
            }
          ]
        },
        "options": {
          "trimValues": true
        }
      }
    },
    {
      "id": "d9af420b-fb23-4311-8b31-227a3733110b",
      "name": "Развернуть ссылки",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "links",
        "options": {}
      }
    },
    {
      "id": "575e84ed-89ce-4562-b25d-4df2ec52dbeb",
      "name": "Полные URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "7bbf0dda-0ab2-482a-92ea-c4e79b547ee0",
              "name": "product_url",
              "value": "={{ 'https://books.toscrape.com/catalogue/' + $json.links }}",
