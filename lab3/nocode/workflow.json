  "nodes": [
    {
      "id": "df62d825-cf00-48b6-949f-a4439b566e57",
      "name": "Ручной запуск",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        160
      ],
      "parameters": {}
    },
    {
      "id": "2d7135aa-588c-4b9e-b0f9-fc41c65dd338",
      "name": "Ежедневно в 09 00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        360
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "f9f06a2c-ab80-45a9-9138-2de4ef468ac0",
      "name": "Получить страницы API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        160
      ],
      "parameters": {
        "url": "https://api.worldbank.org/v2/country/RUS;USA;CHN;IND;BRA;DEU;FRA;JPN;CAN;AUS/indicator/SP.POP.TOTL",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "format",
              "value": "json"
            },
            {
              "name": "date",
              "value": "2020:2022"
            },
            {
              "name": "per_page",
              "value": "10"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "User-Agent",
              "value": "University-Lab3-n8n/1.0"
            }
          ]
        },
        "options": {
          "timeout": 45000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "page",
                    "value": "={{ $pageCount + 1 }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.statusCode !== 200 || !$response.body[1] || $response.body[1].length === 0 || Number($response.body[0].page) >= Number($response.body[0].pages) }}",
              "limitPagesFetched": true,
              "maxRequests": 10,
              "requestInterval": 600
            }
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "45ed8029-de3c-4d7e-83d8-1b3b455104c8",
      "name": "Ответ успешный",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c5e073f8-e4ad-4844-8159-631376b40470",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "988e6dcb-040f-4503-9969-c54caa192a4f",
      "name": "Массив записей",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        60
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d4c84ebe-abf5-4bc3-bc2d-2e273878ca3d",
              "name": "records",
              "value": "={{ $json.body[1] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a4c656f9-558a-49a4-9c96-7b0300401588",
      "name": "Развернуть записи",
