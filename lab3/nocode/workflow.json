    {
      "id": "f8448aa3-56ff-4808-adb4-eeade1667c5b",
      "name": "Преобразовать поля",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1200,
        60
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ff994ffe-eab3-44a9-b649-3623caedd5e7",
              "name": "country_code",
              "value": "={{ $json.countryiso3code }}",
              "type": "string"
            },
            {
              "id": "2784b139-490b-408b-84da-aea953c945fd",
              "name": "country",
              "value": "={{ $json.country.value }}",
              "type": "string"
            },
            {
              "id": "387a4dde-5c47-4c80-ab64-84b9751720ae",
              "name": "year",
              "value": "={{ Number($json.date) }}",
              "type": "number"
            },
            {
              "id": "83d8ba3f-900c-44e6-85c8-83cabf77ffba",
              "name": "population",
              "value": "={{ Number($json.value) }}",
              "type": "number"
            },
            {
              "id": "65464ab8-e946-47ba-8228-abf6f296de1c",
              "name": "population_million",
              "value": "={{ Number($json.value) / 1000000 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "512aa1c1-9b89-4b5c-a9bb-075f01abc015",
      "name": "Создать CSV",
