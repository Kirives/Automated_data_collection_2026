      "parameters": {
        "jsCode": "const norm = v => String(v ?? '').normalize('NFKC').replace(/[\\u200B-\\u200D\\uFEFF]/g,'').replace(/\\s+/g,' ').trim();\nreturn $input.all().map(item => {\n const r=item.json; const value=norm(r.value).replace(/[£, ]/g,'');\n const match=value.match(/^(\\d+)(?:\\.(\\d{1,2}))?$/);\n const minor=match ? BigInt(match[1])*100n+BigInt((match[2]||'').padEnd(2,'0')) : 0n;\n const title=norm(r.title), key=norm(r.business_key), source=norm(r.source).toLowerCase(), unit=norm(r.unit);\n const valid=Boolean(key && title.length>=2 && minor>0n && minor<=200000000000n && ['GBP','persons'].includes(unit));\n return {json:{business_key:key,title,source,value:match?match[1]+'.'+(match[2]||'').padEnd(2,'0'):value,\n  unit,source_url:norm(r.source_url),valid,reason:valid?'':'Пустое поле, неверное число или единица'}};\n});"
      }
    },
