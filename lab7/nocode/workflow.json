        250
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "b28fb210-7169-4e3b-beb6-9dee141fb908",
              "leftValue": "={{ Boolean($json.statusCode === 200 && Array.isArray($json.body?.items) && $json.body.items.length >= 5) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
